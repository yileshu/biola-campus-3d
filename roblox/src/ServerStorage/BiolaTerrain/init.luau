--[[
	BiolaTerrain — builds the campus terrain from USGS 3DEP lidar heights and OpenStreetMap
	surface materials (generated by Tools/roblox/build_roblox.py into the Data folder).

	Bake it once in Studio (recommended), then save the place:
		require(game.ServerStorage.BiolaTerrain).Build()
	If the place is published without baking, ServerScriptService.BuildTerrain builds it on start.

	Scale: 1 stud = 0.3 m. +X = east, -Z = north. Heights are relative to the campus centre.
]]

local BiolaTerrain = {}

local ALPH = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
local DEC = {}
for i = 1, #ALPH do
	DEC[string.byte(ALPH, i)] = i - 1
end

local MATERIAL_NAMES = {
	G = "Grass", L = "LeafyGrass", A = "Asphalt", P = "Pavement", B = "Brick",
	C = "Concrete", S = "Sand", R = "Ground", W = "Water",
}

local CHUNK = 32          -- columns per WriteVoxels call along X and Z
local DEPTH = 16          -- studs of solid ground below the surface

local function loadData(folder)
	local meta = require(folder.Meta)
	local hs = {}
	for k = 1, meta.heightChunks do
		hs[#hs + 1] = require(folder["Heights" .. k])
	end
	local hstr = table.concat(hs)
	local n = meta.hNx * meta.hNz
	local heights = {}
	for i = 0, n - 1 do
		local a = DEC[string.byte(hstr, 2 * i + 1)]
		local b = DEC[string.byte(hstr, 2 * i + 2)]
		heights[i] = (a * 64 + b) * 0.05 + meta.hMin
	end

	local ms = {}
	for k = 1, meta.materialChunks do
		ms[#ms + 1] = require(folder["Materials" .. k])
	end
	local mstr = table.concat(ms, "|")
	local rows = {}
	for row in string.gmatch(mstr, "[^|]+") do
		local codes = {}
		for code, count in string.gmatch(row, "(%a)(%d+)") do
			for _ = 1, tonumber(count) do
				codes[#codes + 1] = code
			end
		end
		rows[#rows + 1] = codes
	end
	return meta, heights, rows
end

-- Bilinear height in metres at local (east, north) metres.
local function sampler(meta, heights)
	local nx, nz, cell, x0, z0 = meta.hNx, meta.hNz, meta.hCell, meta.x0, meta.z0
	local function node(i, j)
		if i < 0 then i = 0 elseif i > nx - 1 then i = nx - 1 end
		if j < 0 then j = 0 elseif j > nz - 1 then j = nz - 1 end
		return heights[j * nx + i]
	end
	return function(e, n)
		local fx = (e - x0) / cell - 0.5
		local fz = (n - z0) / cell - 0.5
		local i, j = math.floor(fx), math.floor(fz)
		local tx, tz = fx - i, fz - j
		local a = node(i, j) * (1 - tx) + node(i + 1, j) * tx
		local b = node(i, j + 1) * (1 - tx) + node(i + 1, j + 1) * tx
		return a * (1 - tz) + b * tz
	end
end

function BiolaTerrain.Build(options)
	options = options or {}
	local folder = script:WaitForChild("Data")
	local terrain = workspace.Terrain
	local t0 = os.clock()
	local meta, heights, rows = loadData(folder)
	local heightAt = sampler(meta, heights)
	local S = 1 / meta.mPerStud
	local M = meta.mPerStud
	local enumOf = {}
	for code, name in pairs(MATERIAL_NAMES) do
		enumOf[code] = Enum.Material[name]
	end
	local AIR, GROUND = Enum.Material.Air, Enum.Material.Ground

	-- World-aligned 4-stud voxel columns covering the data extent.
	local xMin = math.floor(meta.x0 * S / 4) * 4
	local xMax = math.ceil((meta.x0 + meta.hNx * meta.hCell) * S / 4) * 4
	local zMin = math.floor(-(meta.z0 + meta.hNz * meta.hCell) * S / 4) * 4
	local zMax = math.ceil(-meta.z0 * S / 4) * 4
	local cols = (xMax - xMin) / 4
	local deps = (zMax - zMin) / 4

	local function codeAt(e, n)
		local i = math.floor((e - meta.x0) / meta.voxel) + 1
		local j = math.floor((n - meta.z0) / meta.voxel) + 1
		local row = rows[j]
		if not row then return "G" end
		return row[i] or "G"
	end

	-- Build chunks nearest the spawn first so players have ground quickly.
	local chunks = {}
	for cx = 0, cols - 1, CHUNK do
		for cz = 0, deps - 1, CHUNK do
			local mx = xMin + (cx + CHUNK / 2) * 4
			local mz = zMin + (cz + CHUNK / 2) * 4
			local d = (mx - (options.firstX or 0)) ^ 2 + (mz - (options.firstZ or 0)) ^ 2
			chunks[#chunks + 1] = { cx = cx, cz = cz, d = d }
		end
	end
	table.sort(chunks, function(a, b) return a.d < b.d end)

	local written = 0
	for _, ch in ipairs(chunks) do
		local nxc = math.min(CHUNK, cols - ch.cx)
		local nzc = math.min(CHUNK, deps - ch.cz)
		-- surface heights (studs) and codes for this chunk
		local hs, cs = {}, {}
		local lo, hi = math.huge, -math.huge
		for ix = 1, nxc do
			hs[ix], cs[ix] = {}, {}
			for iz = 1, nzc do
				local sx = xMin + (ch.cx + ix - 0.5) * 4
				local sz = zMin + (ch.cz + iz - 0.5) * 4
				local e, n = sx * M, -sz * M
				local h = heightAt(e, n) * S
				local code = codeAt(e, n)
				hs[ix][iz], cs[ix][iz] = h, code
				if h < lo then lo = h end
				if h > hi then hi = h end
			end
		end
		local y0 = math.floor((lo - DEPTH) / 4) * 4
		local y1 = math.ceil((hi + 4) / 4) * 4
		local ny = (y1 - y0) / 4
		local mats, occ = {}, {}
		for ix = 1, nxc do
			local mx, ox = {}, {}
			mats[ix], occ[ix] = mx, ox
			for iy = 1, ny do
				local my, oy = {}, {}
				mx[iy], ox[iy] = my, oy
				local cy = y0 + (iy - 0.5) * 4
				for iz = 1, nzc do
					local h = hs[ix][iz]
					local code = cs[ix][iz]
					local o
					if cy + 2 <= h then o = 1
					elseif cy - 2 >= h then o = 0
					else o = (h - (cy - 2)) / 4 end
					if o <= 0 then
						my[iz], oy[iz] = AIR, 0
					elseif code == "W" then
						-- pools / fountains: water in the top 6 studs over a concrete basin
						if cy > h - 6 then my[iz], oy[iz] = enumOf.W, 1 else my[iz], oy[iz] = enumOf.C, 1 end
					elseif cy > h - 9 then
						my[iz], oy[iz] = enumOf[code] or enumOf.G, o
					else
						my[iz], oy[iz] = GROUND, o
					end
				end
			end
		end
		local region = Region3.new(
			Vector3.new(xMin + ch.cx * 4, y0, zMin + ch.cz * 4),
			Vector3.new(xMin + (ch.cx + nxc) * 4, y1, zMin + (ch.cz + nzc) * 4))
		terrain:WriteVoxels(region, 4, mats, occ)
		written = written + 1
		if written % 8 == 0 then
			task.wait()
			if options.progress then options.progress(written / #chunks) end
		end
	end

	pcall(function() terrain.Decoration = true end)   -- animated 3D grass blades
	terrain.WaterColor = Color3.fromRGB(70, 140, 170)
	terrain.WaterTransparency = 0.45
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.05
	terrain:SetAttribute("BiolaBuilt", true)
	print(string.format("[Biola] Terrain built: %d chunks in %.1fs", #chunks, os.clock() - t0))
end

return BiolaTerrain
